    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 11px 15px;

    background: #ffffff;

    border: 1px solid #e2e8f0;
    border-radius: 12px;

    color: #111827;
    text-decoration: none;
    font-size: 13px;
    font-weight: 750;

    box-shadow: 0 5px 15px rgba(15,23,42,.05);

    transition: .2s ease;
}

.rr-nearby-link:hover {
    background: #111827;
    border-color: #111827;
