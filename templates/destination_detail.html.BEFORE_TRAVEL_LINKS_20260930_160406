<script id="rr-aurangabad-bihar-link-fix">
(function () {

    function isAurangabadPage() {
        var text = document.body ? document.body.innerText.toLowerCase() : "";
        var url  = window.location.href.toLowerCase();

        return (
            text.indexOf("aurangabad") !== -1 ||
            url.indexOf("aurangabad") !== -1
        );
    }

    function fixAurangabadLinks() {

        if (!isAurangabadPage()) {
            return;
        }

        var links = document.querySelectorAll("a[href]");

        links.forEach(function (link) {

            var href = link.getAttribute("href");

            if (!href) {
                return;
            }

            var lower = href.toLowerCase();

            /*
             * Google Search
             */
            if (
                lower.indexOf("google.com/search") !== -1 ||
                lower.indexOf("google.co.in/search") !== -1
            ) {

                var url;

                try {
                    url = new URL(href, window.location.origin);

                    var q = url.searchParams.get("q");

                    if (q) {

                        if (q.toLowerCase().indexOf("aurangabad") !== -1) {

                            q = q
                                .replace(/aurangabad,\s*maharashtra/ig, "Aurangabad, Bihar")
                                .replace(/aurangabad\s+maharashtra/ig, "Aurangabad, Bihar")
                                .replace(/aurangabad/ig, "Aurangabad, Bihar");

                            if (q.toLowerCase().indexOf("india") === -1) {
                                q += ", India";
                            }

                            url.searchParams.set("q", q);
                            link.setAttribute("href", url.toString());
                        }
                    }

                } catch (e) {}
            }

            /*
             * Google Maps
             */
            if (
                lower.indexOf("google.com/maps") !== -1 ||
                lower.indexOf("google.co.in/maps") !== -1
            ) {

                var mapUrl;

                try {
                    mapUrl = new URL(href, window.location.origin);

                    var mapText = (
                        mapUrl.searchParams.get("q") ||
                        mapUrl.searchParams.get("query") ||
                        ""
                    );

                    if (mapText.toLowerCase().indexOf("aurangabad") !== -1) {

                        mapText = mapText
                            .replace(/aurangabad,\s*maharashtra/ig, "Aurangabad, Bihar")
                            .replace(/aurangabad\s+maharashtra/ig, "Aurangabad, Bihar")
                            .replace(/aurangabad/ig, "Aurangabad, Bihar");

                        if (mapText.toLowerCase().indexOf("india") === -1) {
                            mapText += ", India";
                        }

                        if (mapUrl.searchParams.has("q")) {
                            mapUrl.searchParams.set("q", mapText);
                        }

                        if (mapUrl.searchParams.has("query")) {
                            mapUrl.searchParams.set("query", mapText);
                        }

                        link.setAttribute("href", mapUrl.toString());
                    }

                } catch (e) {}
            }

            /*
             * YouTube search
             */
            if (
                lower.indexOf("youtube.com/results") !== -1
            ) {

                try {

                    var ytUrl = new URL(href, window.location.origin);
                    var ytQuery = ytUrl.searchParams.get("search_query");

                    if (
                        ytQuery &&
                        ytQuery.toLowerCase().indexOf("aurangabad") !== -1
                    ) {

                        ytQuery = ytQuery
                            .replace(/aurangabad,\s*maharashtra/ig, "Aurangabad, Bihar")
                            .replace(/aurangabad\s+maharashtra/ig, "Aurangabad, Bihar")
                            .replace(/aurangabad/ig, "Aurangabad, Bihar");

                        ytUrl.searchParams.set("search_query", ytQuery);

                        link.setAttribute("href", ytUrl.toString());
                    }

                } catch (e) {}
            }

        });

    }

    /*
     * Run after page is completely loaded.
     */
    window.addEventListener("load", function () {

        fixAurangabadLinks();

        /*
         * Some links may be created dynamically.
         */
        setTimeout(fixAurangabadLinks, 500);
        setTimeout(fixAurangabadLinks, 1500);
        setTimeout(fixAurangabadLinks, 3000);

    });

})();
</script>
</body>

</html>























