/* ============================================================
   RR NEW TRAVEL FEATURES
   Premium destination upgrade
   ============================================================ */

.rr-new-travel-features {
    width: min(1180px, calc(100% - 32px));
    margin: 55px auto;
    color: #0f172a;
}

.rr-feature-section {
    position: relative;
    margin-bottom: 24px;
    padding: 28px;
    border-radius: 24px;

    background: linear-gradient(
        145deg,
        #ffffff 0%,
        #f8fafc 100%
    );

    border: 1px solid #e2e8f0;

    box-shadow:
        0 15px 40px rgba(15,23,42,.08),
        inset 0 1px 0 rgba(255,255,255,.9);

    overflow: hidden;
}

.rr-feature-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;

    background: linear-gradient(
        90deg,
        #111827,
        #ef4444,
        #111827
    );
}

.rr-feature-heading {
    margin-bottom: 22px;
}

.rr-feature-label {
    display: inline-flex;
    padding: 6px 11px;
    border-radius: 999px;

    background: #fef2f2;
    border: 1px solid #fee2e2;

    color: #dc2626;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.rr-feature-heading h2 {
    margin: 10px 0 7px;

    color: #0b1220;
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 850;
}

.rr-feature-heading p {
    margin: 0;
    color: #475569;
    line-height: 1.7;
}


/* ============================================================
   PLACE CARDS
   ============================================================ */

.rr-place-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 16px;
}

.rr-place-card {
    display: block;
    padding: 21px;

    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 18px;

    color: #111827;
    text-decoration: none;

    box-shadow: 0 8px 22px rgba(15,23,42,.06);

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

.rr-place-card:hover {
    transform: translateY(-4px);

    border-color: rgba(239,68,68,.30);

    box-shadow:
        0 16px 32px rgba(15,23,42,.10),
        0 4px 12px rgba(239,68,68,.05);
}

.rr-place-icon {
    font-size: 28px;
}

.rr-place-card h3 {
    margin: 12px 0 7px;
    color: #0b1220;
    font-size: 18px;
}

.rr-place-card p {
    margin: 0 0 13px;
    color: #475569;
    line-height: 1.65;
    font-size: 14px;
}

.rr-place-link {
    color: #dc2626;
    font-size: 13px;
    font-weight: 800;
}


/* ============================================================
   ITINERARY
   ============================================================ */

.rr-itinerary-grid {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 18px;
}

.rr-day-card {
    padding: 22px;

    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;

    box-shadow: 0 8px 22px rgba(15,23,42,.06);
}

.rr-day-number {
    display: inline-flex;
    padding: 6px 10px;
    border-radius: 9px;

    background: #111827;
    color: #ffffff;

    font-size: 12px;
    font-weight: 800;
}

.rr-day-card h3 {
    margin: 13px 0 8px;
    color: #0b1220;
}

.rr-day-card p {
    margin: 0;
    color: #475569;
    line-height: 1.7;
}


/* ============================================================
   BUDGET
   ============================================================ */

.rr-budget-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 14px;
}

.rr-budget-card {
    padding: 19px;
    text-align: center;

    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 17px;

    box-shadow: 0 7px 20px rgba(15,23,42,.05);
}

.rr-budget-icon {
    font-size: 25px;
}

.rr-budget-card strong {
    display: block;
    margin-top: 9px;
    color: #0b1220;
}

.rr-budget-card span {
    display: block;
    margin-top: 5px;
    color: #64748b;
    font-size: 13px;
}


/* ============================================================
   PHOTO SPOTS
   ============================================================ */

.rr-photo-grid {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 16px;
}

.rr-photo-card {
    padding: 20px;

    background: linear-gradient(
        145deg,
        #ffffff,
        #f8fafc
    );

    border: 1px solid #e5e7eb;
    border-radius: 18px;

    box-shadow: 0 8px 22px rgba(15,23,42,.06);
}

.rr-photo-card h3 {
    margin: 0 0 8px;
